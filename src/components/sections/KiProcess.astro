---
import { site } from '@/content/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import GlowingStars from '@/components/ui/GlowingStars.astro';
const { process } = site.ki;
---
<section id="ki-prozess" class="section section--dark relative overflow-hidden">
  <GlowingStars class="opacity-60" />
  <div class="container relative">
    <SectionHeading tone="dark" eyebrow={process.eyebrow} title={process.title} />
    <ol class="mt-16 grid gap-6 md:grid-cols-3">
      {process.steps.map((step) => (
        <li class="relative rounded-3xl border border-anthracite-800 bg-anthracite-950/80 p-8 backdrop-blur-sm" data-reveal>
          <span class="font-display text-[3.5rem] leading-none font-light text-gold-700">{step.number}</span>
          <h3 class="font-display text-h3 mt-5">{step.title}</h3>
          <p class="mt-4 text-paper-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
