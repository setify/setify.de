---
import { site } from '@/content/site';
import Eyebrow from '@/components/ui/Eyebrow.astro';
const { privacy } = site.ki;
---
<section id="ki-datenschutz" class="section section--dark relative overflow-hidden">
  <div class="gold-line absolute inset-x-0 top-0" aria-hidden="true"></div>
  <div class="container grid gap-14 lg:grid-cols-[1fr_1fr]">
    <div>
      <Eyebrow>{privacy.eyebrow}</Eyebrow>
      <h2 class="font-display text-h2 mt-5 text-balance" data-split>{privacy.title}</h2>
      <p class="text-lead mt-6 text-paper-muted" data-reveal>{privacy.text}</p>
    </div>
    <ul class="flex flex-col justify-center gap-4" data-reveal>
      {privacy.points.map((point) => (
        <li class="flex items-start gap-4 border-b border-anthracite-800 pb-4 last:border-0">
          <svg class="mt-1 h-4 w-4 shrink-0 text-gold-500" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.5l5.5 2.2v4c0 3.2-2.2 6.1-5.5 6.8-3.3-.7-5.5-3.6-5.5-6.8v-4L8 1.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            <path d="M5.8 8.1l1.5 1.5 3-3.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-sand-100/85">{point}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
