---
import { site } from '@/content/site';
import SectionDivider from '@/components/ui/SectionDivider.astro';
const { numbers } = site;
---
<section id="zahlen" class="relative section--sand border-y border-anthracite-950/10 py-16" data-motion="counters">
  <SectionDivider to="sand" variant="slope" />
  <div class="container grid grid-cols-2 gap-10 md:grid-cols-4">
    {numbers.items.map((n) => (
      <div data-reveal>
        <p class="font-display text-numeral leading-none text-gold-700">
          <span data-counter data-value={n.value} data-suffix={n.suffix}>{n.value}{n.suffix}</span>
        </p>
        <p class="mt-3 text-label text-ink-muted">{n.label}</p>
      </div>
    ))}
  </div>
</section>
