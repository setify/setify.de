---
import { site } from '@/content/site';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Sparkles from '@/components/ui/Sparkles.astro';
import KiConsole from '@/components/ui/KiConsole.astro';
const { hero } = site.ki.page;
---
<section id="ki-hero" class="section--dark relative flex min-h-[86svh] items-center overflow-hidden pt-32 pb-24">
  <Sparkles />

  <div class="pointer-events-none absolute -left-40 top-1/3 h-[46rem] w-[46rem] -translate-y-1/2 opacity-50 [filter:blur(130px)]" aria-hidden="true"
       style="background: radial-gradient(circle, rgba(189,172,137,0.28), rgba(122,106,76,0.12) 45%, transparent 70%)"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-[linear-gradient(to_bottom,transparent,#1a1b1e)]" aria-hidden="true"></div>

  <div class="container relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <Eyebrow>{hero.eyebrow}</Eyebrow>
        <h1 class="font-display text-h1 mt-7 text-balance">
          {hero.title} <span class="gold-gradient-text">{hero.titleAccent}</span>
        </h1>
        <p class="text-lead mt-8 max-w-[46ch] text-paper-muted" data-reveal>{hero.lead}</p>

        <div class="mt-10 flex flex-wrap gap-4" data-reveal>
          <Button href={hero.primary.href} magnetic>{hero.primary.label}</Button>
          <Button href={hero.secondary.href} variant="ghost">{hero.secondary.label}</Button>
        </div>
      </div>

      <KiConsole />
    </div>
  </div>
</section>
