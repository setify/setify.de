---
import { site } from '@/content/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
const { process } = site;
---
<section id="prozess" class="section section--sand overflow-hidden border-t border-anthracite-950/10" data-motion="process">
  <div class="container">
    <SectionHeading tone="sand" eyebrow={process.eyebrow} title={process.title} />
    <div class="relative mt-6 h-px w-full bg-anthracite-950/10" aria-hidden="true">
      <div class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-gold-700" data-process-progress></div>
    </div>
  </div>

  <div class="mt-12 lg:mt-16">
    <ol class="container flex flex-col gap-6 lg:w-max lg:max-w-none lg:flex-row lg:gap-8" data-process-track>
      {process.steps.map((step) => (
        <li
          class="glow-card glow-card--sand group relative overflow-hidden rounded-3xl border border-anthracite-950/10 bg-sand-50 lg:h-[26.5rem] lg:w-[46rem] lg:shrink-0"
          data-process-card
          data-reveal
        >
          <div class="flex h-full flex-col sm:flex-row">
            <!-- Bild bündig an der linken Kante, fuellt die Kartenhoehe. -->
            <div class="relative w-full shrink-0 sm:w-[16rem] lg:w-[20rem]">
              <ImagePlaceholder
                id={step.image.id}
                ratio={step.image.ratio}
                label={step.image.label}
                alt={step.image.alt}
                prompt={step.image.prompt}
                tone="sand"
                fill
                class="!rounded-none h-56 sm:h-full"
              />
            </div>

            <div class="flex flex-1 flex-col justify-between gap-8 p-8 lg:p-10">
              <div class="flex items-start justify-between gap-4">
                <span class="font-display text-numeral leading-none font-light text-gold-700">{step.number}</span>
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-gold-700/25 text-gold-700 transition-colors duration-500 group-hover:border-gold-700/60">
                  <Icon name={step.icon as IconName} size={22} animate />
                </span>
              </div>
              <div>
                <h3 class="font-display text-h3">{step.title}</h3>
                <p class="mt-4 text-ink-muted">{step.text}</p>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
