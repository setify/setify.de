---
import { site } from '@/content/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
const { services } = site.ki;
---
<!--
  Einziger heller Abschnitt der Seite und zugleich der einzige, der quer
  laeuft: ab 1024px haelt die Sektion am oberen Rand und die vier Bausteine
  ziehen beim Scrollen nach links. Dieselbe Mechanik wie im Prozess der
  Startseite, deshalb dasselbe Modul und dieselben Datenattribute.
  Darunter stehen die Karten schlicht untereinander.
-->
<section id="ki-leistungen" class="section--sand relative overflow-hidden py-16 lg:py-20" data-motion="process">
  <div class="gold-line absolute inset-x-0 top-0" aria-hidden="true"></div>

  <!-- Kopf zweispaltig: gepinnt zaehlt jede Zeile Hoehe, die Karte muss
       darunter noch vollstaendig ins Bild passen. -->
  <div class="container">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end lg:gap-16">
      <SectionHeading tone="sand" eyebrow={services.eyebrow} title={services.title} />
      <p class="max-w-[46ch] text-ink-muted lg:pb-2" data-reveal>{services.lead}</p>
    </div>
    <div class="relative mt-10 h-px w-full bg-anthracite-950/10" aria-hidden="true">
      <div class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-gold-700" data-process-progress></div>
    </div>
  </div>

  <div class="mt-10 lg:mt-14">
    <ol class="container flex flex-col gap-6 lg:w-max lg:max-w-none lg:flex-row lg:gap-8" data-process-track>
      {services.items.map((item) => (
        <li
          class="glow-card glow-card--sand group relative overflow-hidden rounded-3xl border border-anthracite-950/10 bg-sand-50 lg:h-[28rem] lg:w-[46rem] lg:shrink-0"
          data-process-card
          data-reveal
        >
          <div class="flex h-full flex-col sm:flex-row">
            <!-- Bild buendig an der linken Kante, fuellt die Kartenhoehe. -->
            <div class="relative w-full shrink-0 sm:w-[13rem] lg:w-[17rem]">
              <ImagePlaceholder
                id={item.image.id}
                ratio={item.image.ratio}
                label={item.image.label}
                alt={item.image.alt}
                prompt={item.image.prompt}
                tone="sand"
                fill
                class="!rounded-none h-52 sm:h-full"
              />
            </div>

            <div class="flex flex-1 flex-col justify-between gap-6 p-8 lg:p-9">
              <div class="flex items-start justify-between gap-6">
                <span class="font-display text-numeral font-light leading-none text-gold-700">{item.number}</span>
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-gold-700/25 text-gold-700 transition-colors duration-500 group-hover:border-gold-700/60">
                  <Icon name={item.icon as IconName} size={22} animate />
                </span>
              </div>

              <div>
                <h3 class="font-display text-h3 text-balance">{item.title}</h3>
                <p class="mt-3 max-w-[42ch] text-ink-muted">{item.text}</p>

                <ul class="mt-6 grid gap-2.5 text-small">
                  {item.points.map((p) => (
                    <li class="flex gap-2.5">
                      <svg class="mt-1.5 h-2.5 w-2.5 shrink-0 text-gold-700" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                        <path d="M1 5h8M5 1v8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                      </svg>
                      <span class="text-anthracite-950/85">{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
