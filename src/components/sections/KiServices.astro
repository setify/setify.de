---
import { site } from '@/content/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import KiServiceCard from '@/components/ui/KiServiceCard.astro';
const { services } = site.ki;
---
<section id="ki-leistungen" class="section section--dark">
  <div class="container">
    <SectionHeading tone="dark" eyebrow={services.eyebrow} title={services.title} lead={services.lead} />
    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {services.items.map((item) => (
        <KiServiceCard number={item.number} title={item.title} text={item.text} points={item.points} />
      ))}
    </div>
  </div>
</section>
