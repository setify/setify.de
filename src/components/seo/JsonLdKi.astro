---
import { site } from '@/content/site';
const { ki, meta } = site;
const url = `${meta.url}${ki.path}`;

const data = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: 'KI-Beratung und Automatisierung',
      description: ki.page.meta.description,
      url,
      serviceType: 'KI-Beratung, Workflow-Automatisierung, Systemintegration',
      provider: { '@id': `${meta.url}#organization` },
      areaServed: 'DE',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: ki.services.title,
        itemListElement: ki.services.items.map((item) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: item.title, description: item.text },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: ki.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: meta.url },
        { '@type': 'ListItem', position: 2, name: ki.page.hero.eyebrow, item: url },
      ],
    },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '<')} />
