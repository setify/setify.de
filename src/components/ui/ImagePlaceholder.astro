---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  ratio: '4:5' | '3:2' | '4:3' | '3:4' | '16:9' | '1:1';
  label: string;
  alt: string;
  /** Bildbeschreibung fuer die Produktion, wird im Platzhalter mit ausgegeben. */
  prompt?: string;
  /** Setzen, wenn ueber dem Bild eine Textebene liegt (z. B. Branchen-Kacheln).
   *  Haelt den Prompt-Text aus dem Bereich der Ueberschrift heraus. */
  overlay?: boolean;
  tone?: 'dark' | 'sand';
  class?: string;
  parallax?: boolean;
}
const { id, ratio, label, alt, prompt, overlay = false, tone = 'dark', class: className = '', parallax = false } = Astro.props;

const ratios = { '4:5': '4 / 5', '3:2': '3 / 2', '4:3': '4 / 3', '3:4': '3 / 4', '16:9': '16 / 9', '1:1': '1 / 1' };
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const match = Object.entries(images).find(([path]) => path.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === id);
const image = match?.[1].default;

// Bei sichtbarem Prompt bestimmt der Text die Hoehe: aspect-ratio wuerde eine
// feste Hoehe erzwingen und der Text wuerde unter overflow-hidden abreissen.
// Das Zielformat steht ohnehin im Label des Platzhalters.
const showPrompt = !image && Boolean(prompt);
const bg = tone === 'dark' ? 'bg-anthracite-900' : 'bg-sand-200';
const fg = tone === 'dark' ? 'text-paper-muted' : 'text-ink-muted';
---
<figure class={`relative overflow-hidden rounded-2xl ${bg} ${className}`} style={showPrompt ? 'min-height: 11rem' : `aspect-ratio: ${ratios[ratio]}`} data-image-id={id}>
  {image ? (
    <Image src={image} alt={alt} class="h-full w-full object-cover" data-parallax={parallax ? '' : undefined} widths={[480, 768, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" />
  ) : (
    <div class="relative grid min-h-full w-full place-items-center" data-parallax={parallax ? '' : undefined}>
      <svg class="absolute inset-0 h-full w-full opacity-60" aria-hidden="true">
        <defs>
          <linearGradient id={`ph-${id}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7a6a4c" stop-opacity="0.35" />
            <stop offset="1" stop-color="#e3d6b8" stop-opacity="0.15" />
          </linearGradient>
        </defs>
        <rect width="100%" height="100%" fill={`url(#ph-${id})`} />
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="#bdac89" stroke-opacity="0.3" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="#bdac89" stroke-opacity="0.3" />
      </svg>
      <div class={`relative z-10 flex w-full flex-col items-center justify-center gap-3 px-5 pt-6 text-center ${showPrompt && overlay ? 'pb-32' : 'pb-6'}`} aria-hidden="true">
        <div class={`shrink-0 rounded-full border border-gold-500/40 px-4 py-2 text-label ${fg}`}>
          BILD: {label}, {ratio}
        </div>
        {prompt && (
          <p class={`max-w-[46ch] text-[0.6rem] leading-[1.45] ${fg}`}>{prompt}</p>
        )}
      </div>
      <span class="sr-only">{alt}</span>
    </div>
  )}
  <span class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-gold-500/20" aria-hidden="true"></span>
</figure>
