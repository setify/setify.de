---
import Icon, { type IconName } from '@/components/ui/Icon.astro';

interface Props {
  number: string;
  icon?: IconName;
  title: string;
  text: string;
  points: string[];
  tone?: 'dark' | 'sand';
  class?: string;
}
const { number, title, text, points, icon, tone = 'dark', class: className = '' } = Astro.props;
const sand = tone === 'sand';
const flaeche = sand
  ? 'border-anthracite-950/10 bg-sand-50 hover:border-gold-700/35'
  : 'border-gold-500/15 bg-anthracite-900/60 hover:border-gold-500/40';
const akzent = sand ? 'text-gold-700' : 'text-gold-500';
const fliess = sand ? 'text-ink-muted' : 'text-sand-100/75';
const punkt = sand ? 'text-anthracite-950/85' : 'text-sand-100/85';
const ring = sand ? 'border-gold-700/25 text-gold-700 group-hover:border-gold-700/60' : 'border-gold-500/25 text-gold-500 group-hover:border-gold-500/60';
---
<article
  class={`group relative flex flex-col overflow-hidden rounded-3xl border p-8 transition-colors duration-500 ${flaeche} ${className}`}
  data-reveal
>
  <span
    class="pointer-events-none absolute inset-x-0 top-0 h-px opacity-40 transition-opacity duration-500 group-hover:opacity-100"
    style="background: var(--gold-gradient)"
    aria-hidden="true"></span>

  <div class="flex items-center justify-between gap-4">
    <span class={`font-display text-h3 ${akzent}`}>{number}</span>
    {icon && (
      <span class={`grid h-11 w-11 shrink-0 place-items-center rounded-full border transition-colors duration-500 ${ring}`}>
        <Icon name={icon} size={20} animate />
      </span>
    )}
  </div>

  <h3 class="font-display text-h3 mt-6 text-balance">{title}</h3>
  <p class={`mt-4 ${fliess}`}>{text}</p>

  <ul class="mt-7 flex flex-col gap-3 text-small">
    {points.map((p) => (
      <li class="flex gap-3">
        <svg class={`mt-1.5 h-2.5 w-2.5 shrink-0 ${akzent}`} viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M1 5h8M5 1v8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        </svg>
        <span class={punkt}>{p}</span>
      </li>
    ))}
  </ul>
</article>
