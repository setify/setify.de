---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Zitat-Buehne statt Kartenreihe: ein grosses Zitat, rechts ein Index der
 * Stimmen mit Logo und laufendem Fortschritt.
 *
 * Ohne JS stehen alle Zitate untereinander und sind vollstaendig lesbar. Erst
 * `html.js` legt sie uebereinander und blendet das aktive ein, dieselbe
 * Gating-Logik wie bei `data-reveal`.
 */
interface Stimme {
  quote: string;
  company: string;
  logo?: string;
  pending?: boolean;
}
interface Props {
  items: Stimme[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
const id = 'stimmen';

const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.{jpg,jpeg,png,webp}', { eager: true });
const findeLogo = (name?: string): ImageMetadata | undefined => {
  if (!name) return undefined;
  const treffer = Object.entries(logos).find(
    ([pfad]) => pfad.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === name,
  );
  return treffer?.[1].default;
};
---
<div
  class={`grid gap-12 lg:grid-cols-[1.55fr_1fr] lg:items-center lg:gap-20 ${className}`}
  data-motion="quotes"
  data-quote-root
>
  <div class="relative min-h-[22rem] sm:min-h-[18rem] lg:min-h-[19.5rem]" data-quote-stage>
    <svg
      class="pointer-events-none absolute -left-2 -top-8 h-24 w-24 text-gold-500/10 sm:-left-6 sm:-top-12 sm:h-32 sm:w-32"
      viewBox="0 0 48 48"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M20 10c-7 3-12 9-12 17 0 6 4 11 10 11s10-4 10-10-4-10-9-10c0-3 2-6 6-8zm22 0c-7 3-12 9-12 17 0 6 4 11 10 11s10-4 10-10-4-10-9-10c0-3 2-6 6-8z" />
    </svg>

    {items.map((s, i) => (
      <figure
        class="relative"
        id={`${id}-panel-${i}`}
        role="tabpanel"
        aria-labelledby={`${id}-tab-${i}`}
        data-quote-slide
        data-aktiv={i === 0 ? '' : undefined}
      >
        <blockquote class="font-display text-[clamp(1.35rem,0.95rem+1.7vw,2.25rem)] leading-[1.25] font-light text-sand-100 text-balance">
          <span data-quote-text>{s.quote}</span>
        </blockquote>

        <figcaption class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2" data-quote-meta>
          <span class="h-px w-8 bg-gold-500" aria-hidden="true"></span>
          <span class="text-label text-gold-500">{s.company}</span>
          {s.pending && (
            <span class="rounded-full border border-gold-700/40 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-paper-muted">
              Freigabe ausstehend
            </span>
          )}
        </figcaption>
      </figure>
    ))}
  </div>

  <div
    class="flex flex-col lg:border-l lg:border-anthracite-800 lg:pl-10"
    role="tablist"
    aria-label="Kundenstimmen"
    aria-orientation="vertical"
    data-quote-tabs
  >
    {items.map((s, i) => {
      const logo = findeLogo(s.logo);
      return (
        <button
          type="button"
          id={`${id}-tab-${i}`}
          role="tab"
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="group relative flex items-center gap-4 py-3.5 text-left"
          data-quote-tab
        >
          <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-anthracite-800" aria-hidden="true"></span>
          <span
            class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-[image:var(--gold-gradient)]"
            aria-hidden="true"
            data-quote-fortschritt
          ></span>

          {logo ? (
            /* Inaktiv entsaettigt, damit fuenf Fremdfarben die Palette nicht
               sprengen. Nur die laufende Stimme zeigt ihre Markenfarbe. */
            <Image
              src={logo}
              alt=""
              width={72}
              height={72}
              class="h-10 w-10 shrink-0 rounded-full object-cover grayscale opacity-45 transition-[filter,opacity] duration-500 group-hover:opacity-80 group-aria-selected:grayscale-0 group-aria-selected:opacity-100"
              aria-hidden="true"
            />
          ) : (
            <span class="h-10 w-10 shrink-0 rounded-full border border-anthracite-800" aria-hidden="true"></span>
          )}

          <span class="text-[0.95rem] font-medium text-sand-100/70 transition-colors duration-500 group-hover:text-sand-100/90 group-aria-selected:text-sand-100">
            {s.company}
          </span>
        </button>
      );
    })}
  </div>
</div>
