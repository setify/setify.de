---
/**
 * Text, der sich aus Zeichensalat aufloest. Der echte Text steht doppelt im
 * Markup: einmal fuer Screenreader, einmal sichtbar zum Scrambeln. Ohne JS
 * bleibt der sichtbare Teil unveraendert lesbar.
 * Niemals zusaetzlich `data-split` setzen, SplitText wuerde denselben Knoten
 * umschreiben, den das Modul mutiert.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className = '' } = Astro.props;
---
<span class={className} data-motion="encrypted" data-encrypted={text}>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true" data-encrypted-out>{text}</span>
</span>
