---
/**
 * Icons aus dem Lucide-Set (ISC-Lizenz), als Pfade eingebettet statt als Paket.
 * Fuer die knapp zwanzig verwendeten Symbole waere eine Abhaengigkeit samt
 * Tree-Shaking mehr Aufwand als Nutzen.
 *
 * `animate` laesst die Linie beim Erscheinen einmal nachzeichnen.
 */
export type IconName =
  | 'compass' | 'workflow' | 'bot' | 'graduationCap'
  | 'search' | 'penTool' | 'layers' | 'lifeBuoy'
  | 'lightbulb' | 'rocket' | 'shieldCheck' | 'clock'
  | 'gauge' | 'handshake' | 'sparkles';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  animate?: boolean;
}
const { name, size = 24, strokeWidth = 1.5, class: className = '', animate = false } = Astro.props;

