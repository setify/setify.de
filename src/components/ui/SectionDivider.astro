---
/**
 * Uebergang zwischen zwei Sektionen mit unterschiedlichem Farbton.
 * Die Form gehoert farblich zur Sektion, in die man hineinlaeuft, und ragt nach
 * oben in die vorherige hinein. Darum eine feine Goldkante mit weichem Saum.
 *
 * Bewusst sehr flache Kurven: steile Wellen wirken nach Baukasten, eine lange
 * ruhige Bewegung wirkt gezeichnet.
 *
 * Gehoert als erstes Kind in die Zielsektion, die `position: relative` braucht
 * (bei `.section` bereits gesetzt).
 */
interface Props {
  /** Farbton der Sektion, in die uebergegangen wird. */
  to: 'dark' | 'sand';
  variant?: 'wave' | 'slope';
  class?: string;
}
const { to, variant = 'wave', class: className = '' } = Astro.props;

const fill = to === 'dark' ? '#1a1b1e' : '#f3eee4';
const edge = to === 'dark' ? 'rgba(189,172,137,0.55)' : 'rgba(122,106,76,0.45)';

const shapes = {
  wave: 'M0 52 C 300 6 620 74 900 44 C 1120 20 1290 40 1440 22 L1440 80 L0 80 Z',
  slope: 'M0 72 L1440 14 L1440 80 L0 80 Z',
};
const edges = {
  wave: 'M0 52 C 300 6 620 74 900 44 C 1120 20 1290 40 1440 22',
  slope: 'M0 72 L1440 14',
};
const id = `div-${variant}-${to}-${Math.random().toString(36).slice(2, 8)}`;
---
<div class={`pointer-events-none absolute inset-x-0 bottom-full h-[clamp(2.5rem,5vw,5rem)] overflow-hidden ${className}`} aria-hidden="true">
  <svg class="h-full w-full" viewBox="0 0 1440 80" preserveAspectRatio="none" fill="none">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color={edge} stop-opacity="0" />
        <stop offset="0.35" stop-color={edge} stop-opacity="1" />
        <stop offset="0.75" stop-color={edge} stop-opacity="0.5" />
        <stop offset="1" stop-color={edge} stop-opacity="0" />
      </linearGradient>
    </defs>
    <path d={shapes[variant]} fill={fill} />
    <path d={edges[variant]} stroke={`url(#${id})`} stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>
</div>
