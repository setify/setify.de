---
/**
 * Auswahl als Pillen statt als Dropdown. Spart den Klick ins Menue, zeigt alle
 * Optionen auf einen Blick und baut kompakter als zwei gestapelte Selects.
 * Technisch sind es Radios, damit FormData und die Zod-Pruefung unveraendert
 * weiterlaufen.
 */
interface Option { value: string; label: string }
interface Props {
  name: string;
  label: string;
  options: Option[];
  required?: boolean;
}
const { name, label, options, required = false } = Astro.props;
---
<fieldset class="min-w-0">
  <legend class="text-label text-ink-muted">
    {label}{required && <span class="text-gold-700"> *</span>}
  </legend>
  <div class="mt-2.5 flex flex-wrap gap-2">
    {options.map((o) => (
      <label class="cursor-pointer">
        <input type="radio" name={name} value={o.value} required={required} class="peer sr-only" />
        <span class="inline-flex select-none items-center rounded-full border border-anthracite-950/15 bg-sand-50 px-3.5 py-2 text-[0.85rem] leading-none text-ink-muted transition-[background-color,border-color,color] duration-300 hover:border-gold-700/50 hover:text-anthracite-950 peer-checked:border-gold-700 peer-checked:bg-gold-700 peer-checked:text-sand-50 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-gold-700">
          {o.label}
        </span>
      </label>
    ))}
  </div>
  <p class="mt-1.5 text-[0.75rem] leading-tight text-red-700 empty:hidden" data-error-for={name} aria-live="polite"></p>
</fieldset>
